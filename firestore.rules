rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function teamData(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data;
    }

    function isMember(teamId) {
      return signedIn() && request.auth.uid in teamData(teamId).memberIds;
    }

    function isManager(teamId) {
      return isMember(teamId) && teamData(teamId).members[request.auth.uid].role in ['owner', 'admin'];
    }

    // Profiles: anyone signed in can look a teammate up by email (needed to add
    // members), but only the owner of the profile can change it.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      // A team manager may append/remove this user's teamIds when adding them.
      allow update: if signedIn() && (
        request.auth.uid == uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamIds'])
      );
      allow delete: if false;
    }

    // Shared roster of people who belong on the team. Any signed-in user can
    // read it; only someone who manages a team may change it.
    match /config/roster {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // Invite-code lookup table. Readable by any signed-in user so they can join
    // with a code; only writable by someone creating or managing the team.
    match /teamCodes/{code} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /teams/{teamId} {
      // Read is checked against the document itself, not via get(). A get() on
      // the same path cannot be resolved while Firestore evaluates a collection
      // query, so `list` (subscribeMyTeams) would be denied outright.
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      // Managers can change anything; anyone signed in may add *themselves*
      // (invite code / pending invite), and a member may remove themselves.
      // A member may refresh their own cached name/photo, but never their role.
      allow update: if (isMember(teamId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.members[request.auth.uid].role == resource.data.members[request.auth.uid].role)
        || isManager(teamId)
        || (signedIn()
            && request.auth.uid in request.resource.data.memberIds
            && !(request.auth.uid in resource.data.memberIds)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members']))
        || (isMember(teamId)
            && !(request.auth.uid in request.resource.data.memberIds)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members']));

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /tasks/{taskId} {
        allow read, create, update: if isMember(teamId);
        allow delete: if isManager(teamId)
          || (isMember(teamId) && resource.data.createdBy == request.auth.uid);

        match /comments/{commentId} {
          allow read: if isMember(teamId);
          allow create: if isMember(teamId) && request.resource.data.authorId == request.auth.uid;
          allow update, delete: if isMember(teamId)
            && (resource.data.authorId == request.auth.uid || isManager(teamId));
        }
      }

      match /timeLogs/{logId} {
        allow read: if isMember(teamId);
        allow create: if isMember(teamId) && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isMember(teamId)
          && (resource.data.userId == request.auth.uid || isManager(teamId));
      }
    }

    // Pending invites hold only an email, a team name and a role. Reads are open
    // to signed-in users because the two queries against this collection (mine
    // by email, and a team's pending list) are `list` operations, which cannot
    // use the get() a manager check needs. Writes stay locked to managers, and
    // the invited person may clear their own.
    match /invites/{inviteId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isManager(request.resource.data.teamId);
      allow delete: if signedIn() && (
        resource.data.email == request.auth.token.email.lower() ||
        isManager(resource.data.teamId)
      );
    }
  }
}
